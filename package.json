{
  "name": "saga",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --web --clear",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint src",
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/check-content.ts",
    "check": "npm run typecheck && npm test && npm run content:check",
    "web:build": "expo export --platform web && tsx scripts/build-pwa.ts",
    "web:serve": "npm run web:build && tsx scripts/serve-dist.ts",
    "cert": "bash scripts/make-local-cert.sh",
    "web:serve:https": "npm run web:build && tsx scripts/serve-dist.ts --https"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|fflate)"
    ]
  }
}
